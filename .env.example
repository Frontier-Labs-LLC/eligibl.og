# Server only. Set these on the Vercel project
# (Settings → Environment Variables), then redeploy.
# Do not prefix them with REACT_APP_. They must never ship to the browser.
#
# Use one pair. Connecting the Vercel Marketplace Upstash or KV
# integration fills in the KV_ pair for you.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults to eligibl:visitors:
# VISITOR_KEY_PREFIX=

# Google sign-in for /admin. Create a Web OAuth client and set the
# redirect URI to https://eligibl.org/api/auth/callback
# (and http://localhost:3000/api/auth/callback for `vercel dev`).
# ADMIN_GOOGLE_EMAILS is a comma-separated list of accounts that may sign in.
# ADMIN_SESSION_SECRET is a long random string, for example `openssl rand -hex 32`.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ADMIN_SESSION_SECRET=
# ADMIN_GOOGLE_EMAILS=
