# Server only. Set these on the Vercel project
# (Settings → Environment Variables), then redeploy.
# Do not prefix them with REACT_APP_. They must never ship to the browser.
#
# Use one pair. Connecting the Vercel Marketplace Upstash or KV
# integration fills in the KV_ pair for you.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Defaults to eligibl:visitors:
# VISITOR_KEY_PREFIX=

# Google sign-in for https://eligibl.org/admin.
# Redirect URI: https://eligibl.org/api/auth/callback
# JavaScript origin: https://eligibl.org
# ADMIN_GOOGLE_EMAILS is a comma-separated allow list.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ADMIN_SESSION_SECRET=
# ADMIN_GOOGLE_EMAILS=
